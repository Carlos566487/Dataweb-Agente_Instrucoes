# Azure AI Foundry — Agent Service
# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA commite o .env.local. O .gitignore já o exclui.

# Endpoint do projeto no Azure AI Foundry
AZURE_AI_PROJECT_ENDPOINT=https://2605-foundry-infra-2.services.ai.azure.com/api/projects/2605-foundry-infra-2

# ID do agente no Foundry
AZURE_AI_AGENT_ID=Agent223

# Service Principal (Entra ID) — obrigatório para deploy (Netlify/Azure App Service)
# Em desenvolvimento local, use `az login` e estas variáveis são opcionais.
# O Service Principal precisa da role "Azure AI Developer" atribuída ao Hub/Project.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
